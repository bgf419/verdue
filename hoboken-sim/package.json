{
  "name": "hoboken-in-motion",
  "private": true,
  "type": "module",
  "description": "Agent-based simulation of one day in Hoboken, NJ, with optional Jev-made decisions",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:data": "python3 scripts/build_data.py",
    "bundle": "node scripts/bundle.mjs",
    "jev": "node jev/run-jev.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  }
}
